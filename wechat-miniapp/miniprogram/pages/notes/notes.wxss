.notes-page { height: 100vh; display: flex; flex-direction: column; background: #fff8f5; overflow: hidden; }
.notes-topbar { position: relative; flex: none; }
.notes-title { position: absolute; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; white-space: nowrap; }
.notes-title text { color: #e84f71; font-size: 15rpx; font-weight: 850; letter-spacing: .12em; }
.notes-title-main { margin-top: 2rpx; font-size: 25rpx; font-weight: 850; }
.message-list { flex: 1; height: 0; box-sizing: border-box; padding: 25rpx 28rpx; }
.empty { padding: 120rpx 30rpx; color: #9b8189; font-size: 25rpx; line-height: 1.8; text-align: center; white-space: pre-line; }
.message-row { margin: 0 0 24rpx; display: flex; flex-direction: column; align-items: flex-start; }
.message-row.mine { align-items: flex-end; }
.author { margin: 0 13rpx 7rpx; color: #9a8188; font-size: 18rpx; }
.bubble { max-width: 74%; padding: 18rpx 22rpx; box-sizing: border-box; border-radius: 8rpx 25rpx 25rpx 25rpx; color: #3c3034; background: #fff; box-shadow: 0 8rpx 22rpx rgba(100,58,70,.08); font-size: 26rpx; line-height: 1.55; word-break: break-word; }
.mine .bubble { color: #fff; background: linear-gradient(135deg, #e84f71, #f27d97); border-radius: 25rpx 8rpx 25rpx 25rpx; }
.image-bubble { width: 470rpx; padding: 7rpx; overflow: hidden; }
.message-image { display: block; width: 100%; max-height: 560rpx; border-radius: 19rpx; }
.caption { display: block; padding: 14rpx 13rpx 11rpx; }
.meta { margin: 7rpx 13rpx 0; display: flex; gap: 12rpx; color: #aa9299; font-size: 17rpx; }
.read-state { color: #d34d6d; font-weight: 750; }
.bottom-anchor { height: 35rpx; }
.composer { flex: none; padding: 14rpx 22rpx calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #f0dbe0; background: rgba(255,255,255,.96); }
.composer-row { display: flex; align-items: flex-end; gap: 11rpx; }
.image-button, .send-button { flex: none; width: 78rpx; height: 78rpx; min-height: 78rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; border-radius: 23rpx; line-height: 1; }
.image-button { color: #e84f71; background: #fff1f4; font-size: 35rpx; }
.send-button { color: #fff; background: linear-gradient(135deg, #e84f71, #f27d97); font-size: 37rpx; font-weight: 850; }
.message-input { flex: 1; min-height: 78rpx; max-height: 190rpx; padding: 19rpx 21rpx; box-sizing: border-box; border: 1rpx solid #eed6dc; border-radius: 23rpx; background: #fff; font-size: 26rpx; line-height: 1.45; }
.preview-row { margin-bottom: 10rpx; padding: 10rpx; display: flex; align-items: center; gap: 12rpx; border-radius: 18rpx; background: #fff2f5; }
.preview-row image { width: 72rpx; height: 72rpx; border-radius: 14rpx; }
.preview-row text { flex: 1; color: #755e65; font-size: 21rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.preview-row button { width: 56rpx; min-height: 56rpx; margin: 0; padding: 0; border-radius: 50%; color: #b34d66; background: #fff; line-height: 56rpx; }
.status { min-height: 27rpx; margin: 8rpx 5rpx 0; color: #a0878e; font-size: 18rpx; }
.notes-footer { margin-top: 7rpx; display: flex; align-items: center; justify-content: space-between; color: #8e757d; font-size: 18rpx; }
.notes-footer button { min-height: 42rpx; margin: 0; padding: 0 14rpx; color: #c9365a; background: transparent; font-size: 19rpx; line-height: 42rpx; }
.current-user { color: #4b3940; font-weight: 850; }
