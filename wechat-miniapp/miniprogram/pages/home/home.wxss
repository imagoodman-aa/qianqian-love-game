.home-page { padding-top: calc(158rpx + env(safe-area-inset-top)); }
.home-copy { margin-bottom: 24rpx; }
.home-copy .subtitle { margin-bottom: 0; }
.module-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }
.module-card {
  position: relative;
  width: 100%;
  height: 254rpx;
  min-width: 0;
  margin: 0;
  padding: 24rpx 22rpx 22rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  border: 1rpx solid rgba(232,79,113,.11);
  border-radius: 30rpx;
  box-shadow: 0 14rpx 34rpx rgba(95,55,65,.065);
  overflow: hidden;
}
.module-card::before { content: ''; position: absolute; top: -55rpx; right: -48rpx; width: 138rpx; height: 138rpx; border-radius: 50%; background: rgba(255,255,255,.48); }
.module-card.love { background: linear-gradient(145deg, #fffdfd, #ffe6ed); }
.module-card.manual { background: linear-gradient(145deg, #fffefd, #fff1c8); }
.module-card.slot { background: linear-gradient(145deg, #fbfffd, #e5f6ef); }
.module-card.draw { background: linear-gradient(145deg, #fefcff, #eee8ff); }
.module-card.couple { background: linear-gradient(145deg, #fffdfd, #ffe9f2); }
.module-card.album { background: linear-gradient(145deg, #fbfdff, #e8eeff); }
.module-emoji { position: relative; z-index: 1; margin-bottom: 13rpx; font-size: 45rpx; line-height: 1; }
.module-label { position: relative; z-index: 1; color: #e84f71; font-size: 17rpx; font-weight: 850; letter-spacing: .11em; }
.module-title { position: relative; z-index: 1; margin-top: 7rpx; padding-right: 16rpx; font-size: 28rpx; font-weight: 850; line-height: 1.25; }
.module-copy { position: relative; z-index: 1; flex: 1; margin-top: 9rpx; padding-right: 18rpx; color: #876f76; font-size: 19rpx; line-height: 1.45; }
.module-arrow { position: absolute; z-index: 2; right: 20rpx; bottom: 17rpx; display: grid; place-items: center; width: 35rpx; height: 35rpx; border-radius: 50%; color: #d94468; background: rgba(255,255,255,.76); font-size: 20rpx; font-weight: 700; }
.welcome { margin-top: 28rpx; color: #a88d95; font-size: 20rpx; text-align: center; }
